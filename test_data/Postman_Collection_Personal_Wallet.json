{
  "info": {
    "_postman_id": " personal-wallet-test-collection",
    "name": "Personal Wallet - Test Suite & Mock Data",
    "description": "Koleksi Postman untuk pengujian data transaksi, notifikasi e-wallet (GoPay, BCA, DANA, SPayLater), dan pengujian skema local-first Personal Wallet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Notifications (Ingestion Feed)",
      "item": [
        {
          "name": "Simulate GoPay Expense Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageName\": \"com.gojek.app\",\n  \"title\": \"GoPay\",\n  \"text\": \"Pembayaran ke Kopi Kenangan sebesar Rp22.000 berhasil\",\n  \"postTime\": 1725350400000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications/ingest",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "ingest"]
            },
            "description": "Simulasi notifikasi pengeluaran kopi dari GoPay."
          },
          "response": []
        },
        {
          "name": "Simulate GoPay TopUp Notification",
          "request": {
            "method": "POST",
