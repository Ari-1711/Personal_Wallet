              "raw": "{\n  \"packageName\": \"com.unknown.bank\",\n  \"title\": \"Bank Promo\",\n  \"text\": \"Dapatkan cashback 50% setiap pembelian pulsa di aplikasi kami!\",\n  \"postTime\": 1725352000000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications/ingest",
