              "raw": "{\n  \"amount\": 85000,\n  \"type\": \"EXPENSE\",\n  \"source\": \"MANUAL\",\n  \"status\": \"CONFIRMED\",\n  \"sourceAccountName\": \"BCA\",\n  \"merchantOrTitle\": \"Indomaret\",\n  \"timestamp\": 1725354000000,\n  \"categoryType\": \"VARIABLE_ESSENTIAL\",\n  \"subCategory\": \"GROCERIES\"\n}"
